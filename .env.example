# App URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase (Project Settings → API)
# Copy the project URL and the anon / publishable key. Do not put the
# service role key here. Auth and Work data both use this project.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# Server only. Used to send member invite emails. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"

# Optional alias used by newer Supabase docs. Leave blank if you set ANON_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# In the Supabase dashboard:
# 1. SQL Editor: run supabase/schema.sql once (tables, RLS, seed workspace)
# 2. Authentication → URL Configuration
#    Site URL: http://localhost:3000
#    Redirect URLs: http://localhost:3000/auth/callback
# 3. Authentication → Providers → Email: enable email + password
#    Turn off "Confirm email" if you want local sign-up to land in Work immediately
# 4. Authentication → Providers → Google: enable, then paste:
#    Google Cloud OAuth Client ID
#    Google Cloud OAuth Client Secret
#    Authorized redirect URI in Google Cloud:
#    https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# 5. Only @tatari.systems emails are accepted by this app
# 6. Settings → Members uses the service role key to send invite emails

# Outreach (Google Sheets — Master Investor List used by n8n)
# Create a Google Cloud service account, enable Sheets API, download the JSON key.
# Share the spreadsheet with the service account email as Editor (needed for approve / save).
GOOGLE_SHEETS_SPREADSHEET_ID="1-BCptjZIagFdmK4POxmjsg33AGcb_mUaGK1q8TNXUOI"
GOOGLE_SHEETS_SHEET_NAME="Master Investor List"
# Header row 3 / data from row 4 (matches the n8n workflow)
GOOGLE_SHEETS_HEADER_ROW="3"
GOOGLE_SERVICE_ACCOUNT_EMAIL="outreach-reader@YOUR_PROJECT.iam.gserviceaccount.com"
# Paste the private_key from the JSON key. Keep \n escaped as \\n in .env files.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# n8n: add a Webhook trigger on "Tatari Outreach — Research and Queue"
# Body: { limit, firmName?, triggeredBy, source, startedAt }
# Optional: if firmName is set, process only that firm (limit 1).
# Prefer writing Outreach Status = "Draft ready" (not Scheduled) after GPT draft.
N8N_OUTREACH_WEBHOOK_URL="https://YOUR_N8N_HOST/webhook/outreach-prepare"
# Optional shared secret; n8n should check header x-tatari-webhook-secret
N8N_OUTREACH_WEBHOOK_SECRET=""

# Re-run supabase/schema.sql (or the outreach_runs create table) for run history.