generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model InternalUser {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  displayName     String?
  role            String     @default("reviewer")
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  auditLogs       AuditLog[]
  createdProjects Project[]  @relation("ProjectCreatedBy")
  createdTasks    Task[]     @relation("TaskCreatedBy")
  assignedTasks   Task[]     @relation("TaskAssignee")

  @@index([role, isActive])
}

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  taskSeq   Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  projects  Project[]
  tasks     Task[]
}

model Project {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  name        String
  slug        String
  description String?
  position    Int          @default(0)
  archivedAt  DateTime?    @db.Timestamptz(3)
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy   InternalUser @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, archivedAt, position])
}

model Task {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  projectId   String        @db.Uuid
  number      Int
  title       String
  description String?
  status      String        @default("todo")
  priority    String        @default("none")
  assigneeId  String?       @db.Uuid
  createdById String        @db.Uuid
  dueAt       DateTime?     @db.Timestamptz(3)
  completedAt DateTime?     @db.Timestamptz(3)
  position    Decimal       @db.Decimal(18, 6)
  isTestData  Boolean       @default(false)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy   InternalUser  @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignee    InternalUser? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, number])
  @@index([projectId, status, position])
  @@index([assigneeId, status, dueAt])
  @@index([workspaceId, createdAt])
}

model AuditLog {
  id           String        @id @default(uuid()) @db.Uuid
  entityType   String
  entityId     String
  action       String
  actorId      String?       @db.Uuid
  beforeStatus String?
  afterStatus  String?
  metadata     Json?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  actor        InternalUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
